{
  "name": "ofenbau-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Open-source Vue 3 + Vite website template for a craft business (Ofenbau demo) with optional demo mode, tier flags, calculators and a planning explorer",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:demo": "vite --host 0.0.0.0 --port 5174 --mode demo",
    "build": "node scripts/generate-seo-assets.mjs --mode production && vite build --mode production && node scripts/prerender.mjs --mode production",
    "build:dev": "node scripts/generate-seo-assets.mjs --mode development && vite build --mode development",
    "build:demo": "node scripts/generate-seo-assets.mjs --mode demo && vite build --mode demo",
    "build:basis": "VITE_TIER=basis npm run build",
    "build:premium": "VITE_TIER=premium npm run build",
    "build:demo:basis": "VITE_TIER=basis npm run build:demo",
    "build:demo:premium": "VITE_TIER=premium npm run build:demo",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "preview:demo": "vite preview --host 0.0.0.0 --port 5174",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d --build",
    "demo:url": "node scripts/demo-tunnel-url.mjs",
    "demo:refresh": "docker compose -f docker-compose.demo.yml restart demo-tunnel && sleep 6 && node scripts/demo-tunnel-url.mjs",
    "demo:down": "docker compose -f docker-compose.demo.yml down",
    "demo:pages": "node scripts/check-demo-operator.mjs ofenbau-basis-demo && npm run build:demo:basis && wrangler pages deploy dist --project-name=ofenbau-basis-demo --branch=main",
    "demo:pages:basis": "node scripts/check-demo-operator.mjs ofenbau-basis-demo && npm run build:demo:basis && wrangler pages deploy dist --project-name=ofenbau-basis-demo --branch=main",
    "demo:pages:premium": "node scripts/check-demo-operator.mjs ofenbau-premium-demo && npm run build:demo:premium && wrangler pages deploy dist --project-name=ofenbau-premium-demo --branch=main",
    "demo:pages:generic": "node scripts/check-demo-operator.mjs ofenbau-demo && npm run build:demo:premium && wrangler pages deploy dist --project-name=ofenbau-demo --branch=main",
    "demo:pages:all": "npm run demo:pages:basis && npm run demo:pages:premium && npm run demo:pages:generic",
    "demo:access": "node scripts/demo-access.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{js,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,json}\"",
    "gen:images": "node scripts/generate-images.mjs",
    "gen:video": "node scripts/generate-intro-video.mjs",
    "gen:model": "node scripts/generate-stove-model.mjs",
    "gen:turntable": "node scripts/render-turntable.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "company:check": "node scripts/check-company-profile.mjs",
    "content:review": "node scripts/write-content-review-checklist.mjs",
    "content:placeholders": "node scripts/write-placeholder-content-report.mjs",
    "content:inventory": "node scripts/content-inventory.mjs",
    "content:assets": "node scripts/check-content-assets.mjs",
    "legal:review": "node scripts/write-legal-review-checklist.mjs",
    "deploy:config": "node scripts/check-deployment-config.mjs",
    "a11y:static": "node scripts/check-accessibility-static.mjs",
    "privacy:check": "node scripts/check-privacy-disclosures.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "contact:api": "node server/contact-api.mjs",
    "contact:smoke": "node scripts/smoke-contact-api.mjs",
    "contact:delivery": "node scripts/test-contact-delivery.mjs",
    "launch:contact": "node scripts/write-contact-delivery-checklist.mjs",
    "launch:deployment": "node scripts/write-deployment-cutover-checklist.mjs",
    "launch:performance": "node scripts/write-performance-evidence-checklist.mjs",
    "launch:inputs": "node scripts/write-operator-input-form.mjs",
    "launch:accounts": "node scripts/write-account-verification-checklist.mjs",
    "launch:actions": "node scripts/write-launch-action-items.mjs",
    "launch:evidence": "node scripts/write-launch-evidence-report.mjs",
    "launch:report": "node scripts/check-launch-readiness.mjs",
    "launch:check": "node scripts/check-launch-readiness.mjs --strict",
    "deploy:all": "node scripts/run-deploy-smoke.mjs",
    "deploy:smoke": "node scripts/smoke-deployment.mjs",
    "deploy:seo": "node scripts/smoke-seo-browser.mjs",
    "deploy:indexnow": "node scripts/ping-indexnow.mjs",
    "audit:geo": "node scripts/audit-geo-visibility.mjs",
    "deploy:analytics": "node scripts/smoke-analytics-consent.mjs",
    "deploy:maps": "node scripts/smoke-map-consent.mjs",
    "deploy:links": "node scripts/smoke-contact-links-browser.mjs",
    "deploy:a11y": "node scripts/smoke-accessibility-browser.mjs",
    "deploy:visual": "node scripts/smoke-visual-browser.mjs",
    "deploy:perf": "node scripts/smoke-performance-browser.mjs",
    "preflight": "node scripts/run-preflight.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "demo:mp4": "node scripts/convert-videos.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "secrets:edit": "sops secrets/ofenbau.enc.env"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@google/model-viewer": "4.4.0",
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wrangler": "^4.20.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
