# ---------- Stage 1: build ----------
FROM node:22-bookworm-slim AS build

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json* ./
# `npm ci` requires a lockfile; fall back to `npm install` if absent.
RUN npm ci || npm install

COPY . .

# Build-time public env vars can be injected with --build-arg.
ARG BUILD_MODE=production
ARG VITE_TIER=premium
ARG VITE_APP_ENV
ARG VITE_API_BASE_URL
ARG VITE_APP_TITLE
ARG VITE_APP_URL
ARG VITE_DEMO_PROTECTION_ENABLED
ARG VITE_DEMO_CUSTOMER_NAME
ARG VITE_DEMO_AUTHOR_NAME
ARG VITE_DEMO_AUTHOR_EMAIL
ARG VITE_DEMO_COPYRIGHT_NOTICE
ARG VITE_DEMO_ALLOWED_HOSTS
ARG VITE_DEMO_WATERMARK_ENABLED
ARG VITE_DEMO_ACCESS_CODE_HASH
ENV VITE_TIER=${VITE_TIER}
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_TITLE=${VITE_APP_TITLE}
ENV VITE_APP_URL=${VITE_APP_URL}
ENV VITE_DEMO_PROTECTION_ENABLED=${VITE_DEMO_PROTECTION_ENABLED}
ENV VITE_DEMO_CUSTOMER_NAME=${VITE_DEMO_CUSTOMER_NAME}
ENV VITE_DEMO_AUTHOR_NAME=${VITE_DEMO_AUTHOR_NAME}
ENV VITE_DEMO_AUTHOR_EMAIL=${VITE_DEMO_AUTHOR_EMAIL}
ENV VITE_DEMO_COPYRIGHT_NOTICE=${VITE_DEMO_COPYRIGHT_NOTICE}
ENV VITE_DEMO_ALLOWED_HOSTS=${VITE_DEMO_ALLOWED_HOSTS}
ENV VITE_DEMO_WATERMARK_ENABLED=${VITE_DEMO_WATERMARK_ENABLED}
ENV VITE_DEMO_ACCESS_CODE_HASH=${VITE_DEMO_ACCESS_CODE_HASH}

RUN if [ "$BUILD_MODE" = "demo" ]; then npm run build:demo; \
    elif [ "$BUILD_MODE" = "development" ]; then npm run build:dev; \
    else npm run build; fi

# ---------- Stage 2: serve ----------
FROM nginx:1.27-alpine AS production

# SPA-aware nginx config (history fallback to index.html).
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
