# Production example. Copy values into your deployment environment, not into git.
# Replace every example/token/XXXXXXXX value before running `npm run launch:check`.

# Public site metadata
VITE_APP_ENV="production"
VITE_APP_TITLE="Ofenbau Mustermann"
VITE_APP_DESCRIPTION="Meisterhafter Ofenbau, Kachelöfen und Kamine — handwerkliche Wärme für Ihr Zuhause."
VITE_APP_URL="https://www.example.de"

# Same-origin API is backed by the bundled production contact API in docker-compose.prod.yml.
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT=15000

# Search Console / analytics. Fill only after legal approval and consent text review.
VITE_GOOGLE_SITE_VERIFICATION="google-site-verification-token"
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Production SMTP / contact delivery.
MAIL_HOST="smtp.example.de"
MAIL_PORT=587
MAIL_FROM="website@example.de"
MAIL_TO="kontakt@example.de"
SMTP_TIMEOUT_MS=8000
