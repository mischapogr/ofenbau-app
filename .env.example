# Copy this file to `.env` and adjust values. Never commit your real `.env`.
# Only variables prefixed with VITE_ are exposed to client-side code.

# Product tier: "premium" (full app) or "basis" (reduced build). Orthogonal to
# the build mode. Override per build with an inline prefix, e.g. `VITE_TIER=basis`.
VITE_TIER="premium"

# Public site metadata
VITE_APP_ENV="development"
VITE_APP_TITLE="Ofenbau Mustermann"
VITE_APP_DESCRIPTION="Meisterhafter Ofenbau, Kachelöfen und Kamine — handwerkliche Wärme für Ihr Zuhause."
VITE_APP_URL="http://localhost:5173"

# Search Console / analytics. Leave empty until production consent/legal review is complete.
VITE_GOOGLE_SITE_VERIFICATION=""
VITE_GA_MEASUREMENT_ID=""

# Demo mode (optional gate/watermark/host allow-list). Keep disabled for local development.
VITE_DEMO_PROTECTION_ENABLED="false"
VITE_DEMO_CUSTOMER_NAME="Demo Interessent"
# Shown in the watermark / notice bar when set; leave empty for an anonymous demo.
VITE_DEMO_AUTHOR_NAME=""
VITE_DEMO_AUTHOR_EMAIL=""
VITE_DEMO_COPYRIGHT_NOTICE="Demo-Ansicht: Das Unternehmen ist fiktiv, Inhalte und Daten sind Platzhalter, Bilder KI-generiert."
VITE_DEMO_ALLOWED_HOSTS="localhost,127.0.0.1"
VITE_DEMO_WATERMARK_ENABLED="true"
# Show the Basis/Premium feature catalog on the demo access-code gate ("false" to hide).
VITE_DEMO_FEATURE_CATALOG_ENABLED="true"
# Operator of a public demo (Impressum § 5 DDG / Datenschutz). The business shown
# is fictional, so demo builds name the real operator. Owner-specific: set these
# in .env.demo.local or the encrypted secrets file, not here. Demo deploys refuse
# to run without NAME, STREET, CITY and EMAIL (scripts/check-demo-operator.mjs).
VITE_DEMO_OPERATOR_NAME=""
VITE_DEMO_OPERATOR_STREET=""
VITE_DEMO_OPERATOR_CITY=""
VITE_DEMO_OPERATOR_EMAIL=""
VITE_DEMO_OPERATOR_PHONE=""
# Invite-only preview without published operator details: set to "true" only in
# your git-ignored .env.demo.local. Deploys accept it only for projects with the
# per-customer gate active (KV binding + DEMO_SESSION_SECRET). Your legal call.
VITE_DEMO_GATED_WITHOUT_OPERATOR=""
# SHA-256 hex of the demo access code; empty = no code. Never commit a real hash — see docs/SECRETS.md.
VITE_DEMO_ACCESS_CODE_HASH=""

# API service layer (Axios base URL)
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT=15000

# --- Mailpit (local dev mail catcher) ---
# These are consumed by a backend/mailer, not by the Vite client. Kept here
# for reference so all dev-environment config lives in one place.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="no-reply@ofenbau-mustermann.test"
MAIL_TO="info@ofenbau-mustermann.test"
SMTP_TIMEOUT_MS=8000
# Mailpit web UI: http://localhost:8023
# Override these only if 1025/8025 are taken by another local stack:
MAILPIT_SMTP_PORT=1023
MAILPIT_UI_PORT=8023
