# Copy this file to `.env` and adjust values. Never commit your real `.env`.
# Only variables prefixed with VITE_ are exposed to client-side code.

# Public site metadata
VITE_APP_TITLE="Ofenbau Mustermann"
VITE_APP_DESCRIPTION="Meisterhafter Ofenbau, Kachelöfen und Kamine — handwerkliche Wärme für Ihr Zuhause."
VITE_APP_URL="http://localhost:5173"

# Search Console / analytics. Leave empty until production consent/legal review is complete.
VITE_GOOGLE_SITE_VERIFICATION=""
VITE_GA_MEASUREMENT_ID=""

# API service layer (Axios base URL)
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT=15000

# --- Mailpit (local dev mail catcher) ---
# These are consumed by a backend/mailer, not by the Vite client. Kept here
# for reference so all dev-environment config lives in one place.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="no-reply@ofenbau-mustermann.test"
MAIL_TO="info@ofenbau-mustermann.test"
SMTP_TIMEOUT_MS=8000
# Mailpit web UI: http://localhost:8023
# Override these only if 1025/8025 are taken by another local stack:
MAILPIT_SMTP_PORT=1023
MAILPIT_UI_PORT=8023
