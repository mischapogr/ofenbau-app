{
  "_comment": "Windsurf (Cascade) MCP config. Merge 'mcpServers' into ~/.codeium/windsurf/mcp_config.json (or use Settings → Cascade → MCP → 'Add custom server'). Windsurf uses the same shape as Claude Desktop. Set the filesystem path to your local checkout and replace token placeholders.",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/absolute/path/to/ofenbau-mustermann-app"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "github": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REPLACE_WITH_YOUR_TOKEN"
      }
    },
    "codegraphcontext": {
      "command": "uvx",
      "args": ["codegraphcontext"]
    },
    "stitch": {
      "command": "npx",
      "args": ["-y", "stitch-mcp"],
      "env": {
        "STITCH_API_KEY": "REPLACE_WITH_YOUR_STITCH_KEY"
      }
    }
  }
}
