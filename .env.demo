# Public demo defaults for unsigned/potential customer presentations.
# These values are shipped to the browser; keep real secrets in hosting access control.
VITE_TIER="premium"
VITE_APP_ENV="demo"
VITE_APP_TITLE="Ofenbau Mustermann Demo"
VITE_APP_DESCRIPTION="Geschuetzte Demo fuer Ofenbau, Kacheloefen, Kamine und 3D-Planung."
VITE_APP_URL="https://demo.example.de"

VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT=15000

VITE_GOOGLE_SITE_VERIFICATION=""
VITE_GA_MEASUREMENT_ID=""

VITE_DEMO_PROTECTION_ENABLED="true"
VITE_DEMO_CUSTOMER_NAME="Demo Interessent"
VITE_DEMO_AUTHOR_NAME="Mischa Pogrebnyak"
VITE_DEMO_AUTHOR_EMAIL="66591935+mischapogr@users.noreply.github.com"
VITE_DEMO_COPYRIGHT_NOTICE="Urheberrechtlich geschuetzte Demo. Nutzung nur zur internen Pruefung. Kopieren, Weitergabe, Nachbau und produktive Verwendung sind ohne schriftliche Freigabe untersagt."
VITE_DEMO_ALLOWED_HOSTS="localhost,127.0.0.1,demo.example.de,127.0.0.1,*.trycloudflare.com,*.pages.dev"
VITE_DEMO_WATERMARK_ENABLED="false"
VITE_DEMO_WATERMARK_FACTOR="0.5"
VITE_DEMO_FEATURE_CATALOG_ENABLED="true"
VITE_DEMO_ACCESS_CODE_HASH="***REMOVED-HASH***"
VITE_DEMO_OBFUSCATE="true"
VITE_DEMO_OBFUSCATE_AGGRESSIVE="false"
