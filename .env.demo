# Public demo defaults (mode "demo"). Every value here ships to the browser.
# Real secrets never belong in a VITE_* variable — see docs/SECRETS.md.
VITE_TIER="premium"
VITE_APP_ENV="demo"
VITE_APP_TITLE="Ofenbau Mustermann Demo"
VITE_APP_DESCRIPTION="Demo fuer Ofenbau, Kacheloefen, Kamine und 3D-Planung."
VITE_APP_URL="https://demo.example.de"

VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT=15000

VITE_GOOGLE_SITE_VERIFICATION=""
VITE_GA_MEASUREMENT_ID=""

# --- Demo mode (optional): gate, watermark, host allow-list, feature catalog ---
VITE_DEMO_PROTECTION_ENABLED="true"
VITE_DEMO_CUSTOMER_NAME="Demo Interessent"
# Shown in the watermark / notice bar when set; leave empty for an anonymous demo.
VITE_DEMO_AUTHOR_NAME=""
VITE_DEMO_AUTHOR_EMAIL=""
VITE_DEMO_COPYRIGHT_NOTICE="Demo-Ansicht: Das Unternehmen ist fiktiv, Inhalte und Daten sind Platzhalter, Bilder KI-generiert."
VITE_DEMO_ALLOWED_HOSTS="localhost,127.0.0.1,demo.example.de,*.trycloudflare.com,*.pages.dev"
VITE_DEMO_WATERMARK_ENABLED="true"
VITE_DEMO_WATERMARK_FACTOR="0.5"
VITE_DEMO_FEATURE_CATALOG_ENABLED="true"
# Per-package demo deployments the gate catalog cards forward to.
VITE_DEMO_URL_BASIS="https://ofenbau-basis-demo.pages.dev"
VITE_DEMO_URL_PREMIUM="https://ofenbau-premium-demo.pages.dev"
# Operator of a public demo (Impressum § 5 DDG / Datenschutz). The business shown
# is fictional, so demo builds name the real operator. Owner-specific: set these
# in .env.demo.local or the encrypted secrets file, not here. Demo deploys refuse
# to run without NAME, STREET, CITY and EMAIL (scripts/check-demo-operator.mjs).
VITE_DEMO_OPERATOR_NAME=""
VITE_DEMO_OPERATOR_STREET=""
VITE_DEMO_OPERATOR_CITY=""
VITE_DEMO_OPERATOR_EMAIL=""
VITE_DEMO_OPERATOR_PHONE=""
# Invite-only preview without published operator details: set to "true" only in
# your git-ignored .env.demo.local. Deploys accept it only for projects with the
# per-customer gate active (KV binding + DEMO_SESSION_SECRET). Your legal call.
VITE_DEMO_GATED_WITHOUT_OPERATOR=""
# Client-side access code (SHA-256 hex). Empty = no code required. The real hash is
# NOT committed: export it at build time (direnv + sops, see docs/SECRETS.md) or put
# it in the git-ignored .env.demo.local. For a real gate use functions/_middleware.js.
VITE_DEMO_ACCESS_CODE_HASH=""
