# Secrets for MCP servers. Copy to `.mcp.env`, fill in, and export before
# launching your agent (e.g. `set -a; source .mcp.env; set +a`).
# `.mcp.env` is git-ignored. NEVER commit real tokens.

# GitHub MCP — fine-grained or classic PAT with repo scope.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Google Stitch MCP (stitch-mcp) — authenticates via Google Cloud, NOT an API key.
# One-time setup:
#   gcloud auth login
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project YOUR_GCP_PROJECT_ID
#   gcloud beta services mcp enable stitch.googleapis.com
# Then set your GCP project id here:
GOOGLE_CLOUD_PROJECT=
