# Secrets for MCP servers. Copy to `.mcp.env`, fill in, and export before
# launching your agent (e.g. `set -a; source .mcp.env; set +a`).
# `.mcp.env` is git-ignored. NEVER commit real tokens.

# GitHub MCP — fine-grained or classic PAT with repo scope.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Google Stitch MCP (@_davideast/stitch-mcp proxy).
# Get an API key from Stitch (Profile → Stitch settings → API keys → Create key).
STITCH_API_KEY=
STITCH_PROJECT_ID=

# Optional: token auth for wrangler/Cloudflare Pages deploys instead of `wrangler login`.
# Scope: Account → Cloudflare Pages → Edit (see docs/SECRETS.md).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
