# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (never commit real secrets — commit .env.example only)
.env
.env.*
!.env.example
!.env.development
!.env.demo
!.env.production
!.env.production.example

# Editor / OS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/

# Playwright (recorded demo artifacts are generated, not committed)
/test-results/
/playwright-report/
/demo-artifacts/
/blob-report/
/playwright/.cache/

# Vite
.vite/

# MCP secrets (commit only the *.example files)
.mcp.env

# Decrypted / local secret material — only secrets/*.enc.env is committed (sops + age)
*.dec.env
secrets/*.dec.*
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler local state
.wrangler/

# Generated launch/content reports (npm run launch:*, content:*)
docs/generated/*
!docs/generated/.gitkeep
# Per-tool MCP configs are local — generate from .mcp.json (see docs/MCP.md).
.cursor/
.vscode/mcp.json

# IDE / local scratch
.idea/
_tmp/

# Playwright MCP local session data
.playwright-mcp/

# direnv (commit .envrc; ignore its local cache)
.direnv/

# IndexNow key (semi-secret, generated by scripts/generate-seo-assets.mjs)
public/indexnow-key.txt

# Claude Code local state (worktrees of parallel agents, personal settings)
.claude/worktrees/
.claude/settings.local.json
