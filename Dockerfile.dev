# Development image — runs the Vite dev server with hot reload.
# Source code is bind-mounted via docker-compose, so we only install deps here.
FROM node:22-bookworm-slim

ENV NODE_ENV=development
WORKDIR /app

# Install dependencies first to leverage Docker layer caching.
COPY package.json package-lock.json* ./
RUN npm install

# App source is mounted as a volume at runtime (see docker-compose.yml),
# so we don't COPY it into the image for development.

EXPOSE 5173

# --host makes Vite listen on 0.0.0.0 so the port is reachable from the host.
CMD ["npm", "run", "dev"]
