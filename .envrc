# direnv config — auto-loads this project's local env when you `cd` in.
# Run `direnv allow` once to trust this file (re-run after editing it).
#
# Loads git-ignored files if present:
#   .mcp.env  → MCP secrets (STITCH_API_KEY, STITCH_PROJECT_ID, GITHUB token)
#   .env      → app/dev config (VITE_*, MAIL_*)
# This makes ${ENV} placeholders in .mcp.json resolve for Claude Code, Codex, etc.

dotenv_if_exists .env
dotenv_if_exists .mcp.env

# Owner only: secrets encrypted with sops + age (secrets/ofenbau.enc.env).
# Decrypted straight into direnv's environment — nothing is written to disk.
# Requires `sops` + `age` and the private key in ~/.config/sops/age/keys.txt
# (or SOPS_AGE_KEY_FILE). Contributors skip this block automatically.
_sops_file="secrets/ofenbau.enc.env"
_age_key="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
if has sops && [ -f "$_sops_file" ] && [ -f "$_age_key" ]; then
  direnv_load sops exec-env "$_sops_file" 'direnv dump'
fi
unset _sops_file _age_key
