# direnv config — auto-loads this project's local env when you `cd` in.
# Run `direnv allow` once to trust this file (re-run after editing it).
#
# Loads git-ignored files if present:
#   .mcp.env  → MCP secrets (STITCH_API_KEY, STITCH_PROJECT_ID, GITHUB token)
#   .env      → app/dev config (VITE_*, MAIL_*)
# This makes ${ENV} placeholders in .mcp.json resolve for Claude Code, Codex, etc.

dotenv_if_exists .env
dotenv_if_exists .mcp.env
