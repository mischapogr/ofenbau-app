# Local values for Cloudflare Pages Functions when running `npx wrangler pages dev dist`.
# Copy to `.dev.vars` (git-ignored). On Cloudflare the same secret is set with
# `npm run demo:access -- setup` (all demo projects).
# The per-customer gate is active when this secret is set AND the DEMO_ACCESS KV
# binding exists (wrangler.toml). Local codes: `npm run demo:access -- add <id> --local`.
DEMO_SESSION_SECRET=
