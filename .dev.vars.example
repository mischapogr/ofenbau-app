# Local values for Cloudflare Pages Functions when running `npx wrangler pages dev dist`.
# Copy to `.dev.vars` (git-ignored). On Cloudflare, set the same names as secrets:
#   wrangler pages secret put DEMO_ACCESS_CODE --project-name <project>
#   wrangler pages secret put DEMO_SESSION_SECRET --project-name <project>
# Leave DEMO_ACCESS_CODE empty to disable the server-side gate (functions/_middleware.js).
DEMO_ACCESS_CODE=
DEMO_SESSION_SECRET=
